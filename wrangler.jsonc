{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // The Worker name becomes the free URL: <name>.<your-subdomain>.workers.dev
  "name": "ember-lane-coffee",
  "compatibility_date": "2026-10-28",
  // No "main" script: this Worker only serves the files in ./public
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  }
}
